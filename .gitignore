# PURPOSE: Keep build output, per-machine SDK caches, IDE state and locally generated bench
#          logs out of version control, while deliberately retaining the files that pin the
#          toolchain (.fvmrc) and the shared dependency resolution (pubspec.lock).
# INPUTS: None. Git reads this file when deciding whether a path is trackable.
# OUTPUTS: An ignore policy in which every tracked file is either source, configuration, a
#          pinned lockfile or a test fixture.
# KEYWORDS: gitignore, build-artifacts, lockfile, fvm, bench-logs

# ---------------------------------------------------------------------------
# Dart / Flutter build output
# ---------------------------------------------------------------------------
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.mocks.dart

# Melos links local packages through pubspec_overrides.yaml; it is regenerated by
# `melos bootstrap` on every machine and must never be committed.
pubspec_overrides.yaml

# ---------------------------------------------------------------------------
# Toolchain caches — pinned by .fvmrc, installed by bootstrap, never committed
# ---------------------------------------------------------------------------
.fvm/flutter_sdk
.fvm/versions
.fvm/repo

# ---------------------------------------------------------------------------
# Bench / telemetry output produced by local runs.
# Logs are evidence for a specific run on a specific device; they are uploaded as CI
# artifacts, not committed. Fixtures under docs/fixtures are re-included below.
# ---------------------------------------------------------------------------
bench-out/
*.jsonl
!docs/fixtures/**

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Native build intermediates (iOS/Android/desktop)
# ---------------------------------------------------------------------------
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/key.properties
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Flutter/ephemeral/
apps/mobile/linux/flutter/ephemeral/
apps/mobile/macos/Flutter/ephemeral/
apps/mobile/windows/flutter/ephemeral/
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake

# ---------------------------------------------------------------------------
# Secrets — signing material must never reach the repository
# ---------------------------------------------------------------------------
*.keystore
*.jks
key.properties
*.mobileprovision
*.p12

# Rendered evidence for a report is not source. The repository is public and a screenshot of a
# third-party chart is not ours to redistribute; artefacts live outside it, in ChartApp-acl-reports.
shots/

# docs/specs belongs to the HUMAN who owns this project: a spec is authored in the Specs window, never
# by an agent, and an agent adding one silently changes what every agent in the project is told to follow.
docs/specs/
