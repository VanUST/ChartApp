{
  "@@locale": "en",

  "appTitle": "ChartApp — iReal reader",
  "@appTitle": {
    "description": "The application title in the app bar on a surface wide enough for two words.",
    "placeholders": {}
  },

  "openHtmlFile": "Open .html file",
  "@openHtmlFile": { "description": "The button that opens the browser's file chooser for an iReal export." },

  "iRealHtmlFileLabel": "iReal .html file",
  "@iRealHtmlFileLabel": { "description": "The label of the text field holding the path to an iReal export." },

  "load": "Load",
  "@load": { "description": "The button that loads the file named in the path field." },

  "promptFilePath": "Load an iReal .html file to see its songs.\nDefault: {path}",
