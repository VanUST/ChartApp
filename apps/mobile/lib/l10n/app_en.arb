    "description": "The empty state on a platform where a path names the file.",
    "placeholders": { "path": { "type": "String" } }
  },

  "promptWeb": "Open an iReal .html file exported from iReal Pro.\nIt is read in the browser and is not uploaded.",
  "@promptWeb": { "description": "The empty state in a browser, where no path exists." },

  "payloadNoSongs": "The payload carried no songs.",
  "@payloadNoSongs": { "description": "Shown when a parsed export contains no songs at all." },

  "untitled": "Untitled",
  "@untitled": { "description": "The name shown for a chart whose title is empty. Never data: it is the interface's own fallback." },

  "noFileLoaded": "No file loaded.",
  "@noFileLoaded": { "description": "The status bar before anything at all has been loaded." },

  "songCount": "{count, plural, one{{count} song} other{{count} songs}}",
