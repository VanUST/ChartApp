  "@settingsStorageNoteWeb": { "description": "Says where the language choice lives in a browser, and what losing it costs." },

  "languageChanged": "Language: {language}",
  "@languageChanged": {
    "description": "The confirmation shown after the language is switched.",
    "placeholders": { "language": { "type": "String" } }
